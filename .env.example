# Application

APP_NAME=SafeRAG
APP_ENV=development
LOG_LEVEL=INFO


# LLM

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash


# Embeddings

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VERSION=v1


# Vector Database

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=saferag_documents


# Retrieval

TOP_K=5
FETCH_K=20
MMR_LAMBDA=0.7


# Chunking

CHUNK_SIZE=500
CHUNK_OVERLAP=100